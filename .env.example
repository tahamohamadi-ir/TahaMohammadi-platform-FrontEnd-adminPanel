# Do not put credentials here.
#
# Same-origin topology (accepted baseline):
# - Production: reverse proxy serves the admin SPA at /admin/ and forwards /api to Django.
# - Local dev: Vite serves the SPA and proxies /api, /health, and /media to the backend.
#
# Leave VITE_API_BASE empty to use same-origin relative API paths (recommended).
# The dev server proxy forwards those paths to http://localhost:8000.
VITE_API_BASE=
VITE_PUBLIC_SITE_URL=http://127.0.0.1:4321
