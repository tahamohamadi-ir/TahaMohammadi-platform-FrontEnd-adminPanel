# Production image for the admin panel's `admin` service (taha-admin-prod).
# Single-repo build context (unlike Infra/staging/Dockerfile.admin in the
# root repo, which builds from a combined multi-repo checkout) — this repo
# is built and deployed on its own, recreating only the `admin` container
# in the shared taha-cms-prod compose stack.
FROM node:22-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/admin/
COPY --from=build /app/dist/ /usr/share/nginx/html/
