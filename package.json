    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
